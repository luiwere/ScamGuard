# ScamGuard Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# AI Provider (Auto-detects Groq or Fireworks)
# For Groq:
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# For Fireworks AI:
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_STT_MODEL=whisper-v3-turbo
FIREWORKS_LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Telegram Alerts (Trusted Contact)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id_here

# Risk Scoring Thresholds
RISK_THRESHOLD_ALERT=70
RISK_THRESHOLD_WARNING=40
